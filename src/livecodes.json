{
  "title": "DeepAI Code Snippet",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n<title>SHΞN™ AI · OpenRouter</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n@import url('https://cdn.fontcdn.ir/Font/Persian/Vazir/Vazir.css');\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: 'Vazir', sans-serif;\n  background-color: #212121;\n  color: #ececec;\n}\n\n/* استایل پیام کاربر */\n.user-msg {\n  background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.06) 100%);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255,255,255,0.1);\n  border-radius: 1.5rem 1.5rem 1.5rem 0.35rem;\n  padding: 0.75rem 1.25rem;\n  max-width: 85%;\n  word-wrap: break-word;\n  overflow-wrap: break-word;\n  white-space: pre-wrap; /* فعال کردن حفظ خطوط جدید */\n  line-height: 1.8;\n  box-shadow: 0 4px 20px rgba(0,0,0,0.2);\n  color: #fff;\n}\n\n/* استایل پیام‌های ربات */\n.bot-bubble {\n  background: rgba(255,255,255,0.04);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255,255,255,0.07);\n  border-radius: 1.5rem 1.5rem 0.35rem 1.5rem;\n  padding: 0.875rem 1.25rem;\n  line-height: 1.8;\n  word-wrap: break-word;\n  overflow-wrap: break-word;\n  white-space: pre-wrap;\n  color: #ececec;\n}\n\n/* ساختار چیدمان پیام‌ها */\n.msg-row {\n  display: flex;\n  align-items: flex-start;\n  margin-bottom: 1rem;\n}\n\n.msg-row.user {\n  justify-content: flex-start;\n}\n\n.msg-row.bot {\n  justify-content: flex-end;\n}\n\n/* استایل برای پیام‌های کاربر */\n.msg-row.user .message {\n  align-self: flex-start;\n}\n\n/* استایل برای پیام‌های ربات */\n.msg-row.bot .message {\n  align-self: flex-end;\n}\n\n/* استایل‌های دیگر ... (در صورت نیاز) */\n</style>\n</head>\n<body class=\"h-[100dvh] flex flex-col overflow-hidden text-sm md:text-base selection:bg-white/20 selection:text-white\">\n\n<!-- صفحه ورود و احراز هویت -->\n<div id=\"login-overlay\" class=\"fixed inset-0 z-50 flex items-center justify-center bg-gradient-radial from-gray-900 to-gray-950 bg-no-repeat bg-cover bg-blend-multiply backdrop-blur-lg\">\n  <div class=\"bg-white/10 backdrop-blur-xl p-8 rounded-3xl max-w-md w-full text-center text-white shadow-lg\">\n    <h2 class=\"text-xl mb-4\">ورود به SHΞN™ AI</h2>\n    <input type=\"password\" id=\"api-key-input\" placeholder=\"کلید API خود را وارد کنید\" class=\"w-full p-3 rounded-xl bg-white/20 text-white mb-4 focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n    <button id=\"load-models-btn\" class=\"w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition\">بارگذاری مدل‌ها</button>\n    <div id=\"login-status\" class=\"mt-2 text-sm\"></div>\n    <div id=\"login-error\" class=\"mt-2 text-sm text-red-400\"></div>\n    <div class=\"mt-4\">\n      <button id=\"free-entry-btn\" class=\"w-full bg-gray-700 hover:bg-gray-600 text-white py-3 px-4 rounded-xl transition\">ورود رایگان (Pollinations)</button>\n    </div>\n  </div>\n</div>\n\n<!-- هدر -->\n<header class=\"flex items-center justify-between px-2 sm:px-3 py-1.5 sm:py-2 sticky top-0 bg-[#212121]/90 backdrop-blur-md z-30 border-b border-white/5 gap-1 sm:gap-2 flex-wrap\">\n  <div class=\"flex items-center gap-1.5 sm:gap-2 flex-shrink-0\">\n    <span class=\"silver-wave text-sm sm:text-base md:text-lg font-bold tracking-wide\">SHΞN™</span>\n    <span class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse\"></span>\n  </div>\n  <div class=\"flex items-center gap-1 sm:gap-2 flex-1 min-w-0 justify-end md:justify-center\">\n    <div class=\"model-select-wrap\" id=\"model-select-wrap\" style=\"display:none;\">\n      <select id=\"model-select\" class=\"bg-transparent border border-white/20 rounded-xl p-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"></select>\n    </div>\n    <div id=\"api-key-badge\" style=\"display:none;\" title=\"تغییر کلید API\" class=\"flex items-center gap-1 bg-white/5 p-2 rounded-xl cursor-pointer\">\n      <span class=\"key-dot active\" id=\"key-dot\"></span>\n      <span id=\"key-label\" class=\"text-sm\">API</span>\n    </div>\n  </div>\n  <div class=\"flex items-center gap-1 flex-shrink-0\">\n    <button onclick=\"newChat()\" title=\"صفحه جدید\" class=\"text-gray-400 hover:text-white p-1 sm:p-1.5 rounded-lg transition cursor-pointer bg-white/5 hover:bg-white/10\">\n      <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n        <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n      </svg>\n    </button>\n  </div>\n</header>\n\n<!-- محتوای چت -->\n<main id=\"chat-box\" class=\"flex-1 overflow-y-auto px-3 sm:px-4 pt-4 sm:pt-6 pb-36 flex flex-col gap-4 sm:gap-6 md:max-w-3xl md:mx-auto w-full scroll-smooth\">\n  <!-- صفحه خوش‌آمد گویی -->\n  <div id=\"welcome-screen\" class=\"flex flex-col items-center justify-center h-full mt-8 sm:mt-10 md:mt-20 opacity-100 transition-opacity duration-500\">\n    <div class=\"w-20 h-20 sm:w-24 sm:h-24 mb-6 sm:mb-8 flex items-center justify-center relative\">\n      <div class=\"absolute inset-0 bg-white/5 rounded-full blur-xl\"></div>\n      <img src=\"https://raw.githubusercontent.com/shervinofpersia/Gpt/refs/heads/main/1712259501956.png\" class=\"w-full h-full object-contain spin-3d drop-shadow-[0_0_20px_rgba(255,255,255,0.15)] relative z-10\" alt=\"لوگو\" />\n    </div>\n    <h1 class=\"text-xl sm:text-2xl font-bold mb-2 text-center tracking-tight\">چگونه می‌توانم کمک کنم؟</h1>\n  </div>\n  <!-- نشانگر لودینگ -->\n  <div id=\"loading-indicator\" class=\"hidden justify-center items-center p-2\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"silver-wave text-xs sm:text-sm font-bold tracking-widest\">SHΞN™ core process <span class=\"typing-dots\"><span></span><span></span><span></span></span></span>\n      <img src=\"https://raw.githubusercontent.com/shervinofpersia/Gpt/refs/heads/main/1712259501956.png\" class=\"w-7 h-7 sm:w-8 sm:h-8 rounded-full object-contain spin-3d border border-white/10 bg-[#2f2f2f]\" />\n    </div>\n  </div>\n</main>\n\n<!-- بخش پایین (کومپوزر) -->\n<div class=\"fixed bottom-0 w-full bottom-gradient pt-8 sm:pt-10 pb-2 sm:pb-3 px-2 sm:px-4 z-20 bg-[#212121]/90 backdrop-blur-md\">\n  <div class=\"w-full md:max-w-3xl mx-auto flex flex-col gap-1.5 sm:gap-2 relative\">\n    <div id=\"file-attachment-label\" class=\"hidden flex items-center justify-between bg-[#3a3a3a] p-2 rounded-xl text-sm\">\n      <span id=\"file-name-display\"></span>\n      <span class=\"remove-file cursor-pointer text-red-500\" onclick=\"removeAttachedFile()\">✕</span>\n    </div>\n    <div class=\"composer-container rounded-xl py-1 px-1.5 flex items-end gap-0.5 sm:gap-1 border border-[#424242] bg-[#2f2f2f] shadow-2xl relative\">\n      <button id=\"send-btn\" disabled class=\"w-8 h-8 sm:w-9 sm:h-9 bg-[#424242] text-[#ececec] rounded-full flex items-center justify-center cursor-pointer disabled:bg-[#2f2f2f] disabled:text-[#6b7280] transition shadow-lg border border-transparent disabled:border-[#424242]\">\n        <svg class=\"w-4 h-4 sm:w-5 sm:h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\">\n          <line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\" />\n          <polyline points=\"5 12 12 5 19 12\" />\n        </svg>\n      </button>\n      <textarea id=\"user-input\" rows=\"1\" class=\"flex-1 bg-transparent text-white outline-none resize-none py-1.5 sm:py-2 px-1.5 sm:px-2 max-h-[150px] min-h-[32px]\" placeholder=\"پیام بدهید...\"></textarea>\n      <button onclick=\"document.getElementById('file-upload').click()\" title=\"ضمیمه کردن فایل\" class=\"w-8 h-8 sm:w-9 sm:h-9 bg-[#424242] hover:bg-[#555] rounded-full flex items-center justify-center cursor-pointer transition\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path d=\"M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48\" />\n        </svg>\n      </button>\n      <input type=\"file\" id=\"file-upload\" class=\"hidden\" accept=\".txt,.js,.html,.css,.md,.json,.csv\" onchange=\"handleFileUpload(event)\" />\n    </div>\n    <div class=\"text-center text-[10px] sm:text-[11px] text-gray-500 mt-0.5 sm:mt-1\">\n      <a href=\"https://t.me/shervini\" target=\"_blank\" class=\"hover:text-white transition\">☬ ساخته شده توسط SHΞN™</a>\n    </div>\n  </div>\n</div>\n\n<!-- اسکریپت -->\n<script>\n// ثابت‌ها\nconst SYSTEM_PROMPT = '';\nconst MODEL_POLLINATIONS = 'pollinations/ai';\n\nconst chatBox = document.getElementById('chat-box');\nconst userInput = document.getElementById('user-input');\nconst sendBtn = document.getElementById('send-btn');\n\nconst welcomeScreen = document.getElementById('welcome-screen');\nconst loadingIndicator = document.getElementById('loading-indicator');\n\nconst fileAttachmentLabel = document.getElementById('file-attachment-label');\nconst fileNameDisplay = document.getElementById('file-name-display');\n\nconst apiKeyInput = document.getElementById('api-key-input');\nconst loadModelsBtn = document.getElementById('load-models-btn');\nconst freeEntryBtn = document.getElementById('free-entry-btn');\nconst apiKeyBadge = document.getElementById('api-key-badge');\nconst keyDot = document.getElementById('key-dot');\nconst keyLabel = document.getElementById('key-label');\n\nconst modelSelect = document.getElementById('model-select');\nconst modelSelectWrap = document.getElementById('model-select-wrap');\n\nlet apiKey = localStorage.getItem('sh3n_api_key') || '';\nlet isFreeMode = false;\nlet chatHistory = [];\nlet lastRequestTime = 0;\nlet attachedFileContent = '';\nlet attachedFileName = '';\nlet currentModel = MODEL_POLLINATIONS;\n\n// Helper functions\nfunction escapeHTML(str) {\n  return String(str).replace(/[&<>'\"]/g, tag => ({\n    '&': '&amp;', '<': '&lt;', '>': '&gt;', \"'\": '&#39;', '\"': '&quot;'\n  }[tag] || tag));\n}\n\nfunction scrollToBottom() {\n  setTimeout(() => { chatBox.scrollTop = chatBox.scrollHeight; }, 50);\n}\n\nfunction setSendBtnState(hasText) {\n  const enabled = hasText || attachedFileContent !== '';\n  sendBtn.disabled = !enabled;\n  if (enabled) {\n    sendBtn.classList.remove('bg-[#424242]', 'text-[#ececec]');\n    sendBtn.classList.add('bg-white', 'text-black');\n  } else {\n    sendBtn.classList.add('bg-[#424242]', 'text-[#ececec]');\n    sendBtn.classList.remove('bg-white', 'text-black');\n  }\n}\n\nfunction handleFileUpload(event) {\n  const file = event.target.files[0];\n  if (!file) return;\n  const reader = new FileReader();\n  reader.onload = () => {\n    attachedFileContent = reader.result;\n    attachedFileName = file.name;\n    fileNameDisplay.textContent = file.name;\n    fileAttachmentLabel.classList.remove('hidden');\n    userInput.dispatchEvent(new Event('input'));\n    userInput.focus();\n  };\n  reader.readAsText(file);\n  event.target.value = '';\n}\n\nfunction removeAttachedFile() {\n  attachedFileContent = '';\n  attachedFileName = '';\n  fileAttachmentLabel.classList.add('hidden');\n  userInput.dispatchEvent(new Event('input'));\n}\n\n// افزودن پیام کاربر\nfunction appendUserMessage(text, index) {\n  const wrapper = document.createElement('div');\n  wrapper.className = 'msg-row user';\n\n  const messageDiv = document.createElement('div');\n  messageDiv.className = 'message';\n\n  // جایگزینی خطوط جدید با <br>\n  messageDiv.innerHTML = escapeHTML(text).replace(/\\n/g, '<br>');\n\n  wrapper.appendChild(messageDiv);\n  chatBox.appendChild(wrapper);\n  scrollToBottom();\n}\n\n// افزودن پیام ربات\nfunction appendBotMessage(text, index) {\n  const wrapper = document.createElement('div');\n  wrapper.className = 'msg-row bot';\n\n  const messageDiv = document.createElement('div');\n  messageDiv.className = 'message';\n\n  messageDiv.innerHTML = escapeHTML(text).replace(/\\n/g, '<br>');\n\n  wrapper.appendChild(messageDiv);\n  chatBox.appendChild(wrapper);\n  scrollToBottom();\n}\n\n// کپی کردن پیام\nfunction copyMessage(btn) {\n  const text = decodeURIComponent(btn.getAttribute('data-content'));\n  navigator.clipboard.writeText(text).then(() => {\n    const original = btn.innerHTML;\n    btn.innerHTML = `<svg class=\"w-3.5 h-3.5 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>`;\n    setTimeout(() => { btn.innerHTML = original; }, 2000);\n  });\n}\n\n// ویرایش پیام کاربر\nfunction editUserMessage(index) {\n  // پیدا کردن آخرین پیام کاربر\n  let lastUserMsg = '';\n  let userIdx = -1;\n  for (let i = chatHistory.length - 1; i >= 0; i--) {\n    if (chatHistory[i].role === 'user') {\n      lastUserMsg = chatHistory[i].content;\n      userIdx = i;\n      break;\n    }\n  }\n  if (lastUserMsg && userIdx !== -1) {\n    // حذف پیام‌های بعدی\n    chatHistory = chatHistory.slice(0, userIdx);\n    // قرار دادن متن در input\n    userInput.value = lastUserMsg;\n    userInput.focus();\n    setSendBtnState(true);\n  }\n}\n\n// تلاش مجدد برای پیام\nfunction retryMessage(index) {\n  // مشابه ویرایش\n  let lastUserMsg = '';\n  let userIdx = -1;\n  for (let i = chatHistory.length - 1; i >= 0; i--) {\n    if (chatHistory[i].role === 'user') {\n      lastUserMsg = chatHistory[i].content;\n      userIdx = i;\n      break;\n    }\n  }\n  if (lastUserMsg && userIdx !== -1) {\n    chatHistory = chatHistory.slice(0, userIdx);\n    userInput.value = lastUserMsg;\n    userInput.focus();\n    sendMessage();\n  }\n}\n\n// شروع چت جدید\nfunction newChat() {\n  chatHistory = [];\n  document.querySelectorAll('.msg-row').forEach(el => el.remove());\n  chatHistory.push({ role: 'system', content: SYSTEM_PROMPT });\n  userInput.value = '';\n  setSendBtnState(false);\n  removeAttachedFile();\n  welcomeScreen.style.display = 'flex';\n  setTimeout(() => { welcomeScreen.style.opacity = '1'; }, 50);\n}\n\n// ارسال پیام\nasync function sendMessage() {\n  let text = userInput.value.trim();\n  if (attachedFileContent) {\n    text += `\\n[محتوای فایل ضمیمه شده: ${attachedFileName}]\\n\\`\\`\\`\\n${attachedFileContent}\\n\\`\\`\\`\\n`;\n    removeAttachedFile();\n  }\n  if (!text) return;\n\n  // پنهان کردن صفحه خوش‌آمد\n  welcomeScreen.style.opacity = '0';\n  setTimeout(() => { welcomeScreen.style.display = 'none'; }, 300);\n\n  // افزودن پیام کاربر\n  const msgIndex = chatHistory.length;\n  appendUserMessage(text, msgIndex);\n  chatHistory.push({ role: 'user', content: text });\n\n  userInput.value = '';\n  setSendBtnState(false);\n  scrollToBottom();\n\n  // نشان دادن لودینگ\n  loadingIndicator.classList.remove('hidden');\n\n  try {\n    let reply = '';\n\n    if (isFreeMode || currentModel === MODEL_POLLINATIONS) {\n      // درخواست به Pollinations\n      const recentMessages = chatHistory.slice(-10);\n      const body = {\n        messages: recentMessages,\n        model: 'openai-fast',\n        stream: false\n      };\n      const response = await fetch('https://text.pollinations.ai/', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json'\n        },\n        body: JSON.stringify(body)\n      });\n      if (!response.ok) {\n        if (response.status === 429) {\n          await new Promise(res => setTimeout(res, 4000));\n          return sendMessage();\n        }\n        throw new Error(`خطا در درخواست: ${response.status}`);\n      }\n      const rawText = await response.text();\n      let parsed = null;\n      try { parsed = JSON.parse(rawText); } catch (e) { parsed = null; }\n      if (parsed) {\n        reply = extractPollinationsContent(parsed);\n      } else {\n        reply = rawText;\n      }\n    } else {\n      // درخواست به OpenRouter\n      if (!apiKey) throw new Error('کلید API وارد نشده است.');\n      const recentMessages = chatHistory.slice(-10);\n      const response = await fetch('https://openrouter.ai/api/v1/chat/completions', {\n        method: 'POST',\n        headers: {\n          'Authorization': `Bearer ${apiKey}`,\n          'Content-Type': 'application/json'\n        },\n        body: JSON.stringify({\n          model: currentModel,\n          messages: recentMessages\n        })\n      });\n      if (!response.ok) {\n        if (response.status === 429) {\n          await new Promise(res => setTimeout(res, 4000));\n          return sendMessage();\n        }\n        throw new Error(`خطای سرور: ${response.status}`);\n      }\n      const data = await response.json();\n      reply = data.choices?.[0]?.message?.content || 'پاسخی دریافت نشد.';\n    }\n\n    chatHistory.push({ role: 'assistant', content: reply });\n    // افزودن پاسخ به صفحه\n    appendBotMessage(reply, chatHistory.length - 1);\n  } catch (err) {\n    console.error(err);\n    // نمایش خطا در صفحه\n    const errorDiv = document.createElement('div');\n    errorDiv.className = 'msg-row flex justify-end';\n    errorDiv.innerHTML = `\n      <div class=\"bot-msg group relative text-red-400 font-mono\">\n        <div class=\"flex-shrink-0 mt-1\">\n          <img src=\"https://raw.githubusercontent.com/shervinofpersia/Gpt/refs/heads/main/1712259501956.png\" class=\"w-7 h-7 rounded-full border border-red-900 bg-[#1a0000]\" />\n        </div>\n        <div class=\"flex-1 pt-1 whitespace-pre-wrap pb-4 max-w-[85%]\">\n          <div class=\"border border-red-900 bg-red-950 p-2 rounded-lg\">\n            <div class=\"font-bold\">خطا در ارتباط با سرور</div>\n            <div class=\"mt-1\">${escapeHTML(err.message)}</div>\n            <div class=\"mt-1 text-sm\">لطفاً چند لحظه صبر کنید و دوباره تلاش کنید.</div>\n          </div>\n        </div>\n      </div>`;\n    chatBox.appendChild(errorDiv);\n  } finally {\n    loadingIndicator.classList.add('hidden');\n    scrollToBottom();\n  }\n}\n\n// استخراج محتوای پاسخ Pollinations\nfunction extractPollinationsContent(data) {\n  if (typeof data === 'string') return data;\n  if (!data || typeof data !== 'object') return '';\n\n  if (data.choices && Array.isArray(data.choices) && data.choices.length > 0) {\n    const choice = data.choices[0];\n    if (choice.message && typeof choice.message.content === 'string') return choice.message.content;\n    if (typeof choice.text === 'string') return choice.text;\n    if (choice.delta && typeof choice.delta.content === 'string') return choice.delta.content;\n  }\n\n  if (typeof data.content === 'string') return data.content;\n  if (typeof data.text === 'string') return data.text;\n  if (typeof data.response === 'string') return data.response;\n  if (typeof data.result === 'string') return data.result;\n  if (typeof data.output === 'string') return data.output;\n\n  return '';\n}\n\n// بارگذاری مدل‌ها\nasync function fetchModels(key) {\n  const res = await fetch('https://openrouter.ai/api/v1/models', {\n    headers: { 'Authorization': `Bearer ${key}` }\n  });\n  if (!res.ok) throw new Error('خطا در بارگذاری مدل‌ها');\n  const data = await res.json();\n  return data.data || [];\n}\n\n// ساخت لیست مدل‌ها در انتخاب\nfunction buildModelList(models) {\n  modelSelect.innerHTML = '';\n\n  // افزودن مدل رایگان\n  const optFree = document.createElement('option');\n  optFree.value = MODEL_POLLINATIONS;\n  optFree.textContent = '✨ رایگان · Pollinations.ai';\n  optFree.dataset.free = 'true';\n  modelSelect.appendChild(optFree);\n\n  // مدل‌های دیگر\n  models.forEach(m => {\n    const option = document.createElement('option');\n    option.value = m.id || m;\n    option.textContent = m.name || m.id || m;\n    option.dataset.free = (m.pricing && m.pricing.prompt === 0 && m.pricing.completion === 0) ? 'true' : 'false';\n    modelSelect.appendChild(option);\n  });\n\n  modelSelect.value = MODEL_POLLINATIONS;\n  currentModel = MODEL_POLLINATIONS;\n  isFreeMode = true;\n  modelSelectWrap.style.display = 'inline-block';\n\n  // تنظیم onchange\n  modelSelect.onchange = () => {\n    if (modelSelect.value === MODEL_POLLINATIONS) {\n      isFreeMode = true;\n      currentModel = MODEL_POLLINATIONS;\n    } else {\n      isFreeMode = false;\n      currentModel = modelSelect.value;\n    }\n  };\n}\n\n// رویدادهای اولیه\ndocument.getElementById('load-models-btn').onclick = async () => {\n  const key = apiKeyInput.value.trim();\n  if (!key) {\n    document.getElementById('login-error').textContent = 'لطفاً کلید API وارد کنید.';\n    return;\n  }\n  try {\n    const models = await fetchModels(key);\n    localStorage.setItem('sh3n_api_key', key);\n    buildModelList(models);\n    document.getElementById('login-overlay').classList.add('hidden');\n  } catch (err) {\n    document.getElementById('login-error').textContent = err.message;\n  }\n};\n\ndocument.getElementById('free-entry-btn').onclick = () => {\n  chatHistory = [{ role: 'system', content: SYSTEM_PROMPT }];\n  document.getElementById('login-overlay').classList.add('hidden');\n  userInput.focus();\n  isFreeMode = true;\n  currentModel = MODEL_POLLINATIONS;\n  modelSelect.value = MODEL_POLLINATIONS;\n  modelSelectWrap.style.display = 'inline-block';\n};\n\n// رویدادهای پیام\nsendBtn.onclick = () => {\n  if (!sendBtn.disabled) sendMessage();\n};\n\nuserInput.oninput = () => {\n  setSendBtnState(userInput.value.trim() !== '' || attachedFileContent !== '');\n};\n\nuserInput.onkeydown = (e) => {\n  if (e.key === 'Enter' && !e.shiftKey) {\n    e.preventDefault();\n    if (!sendBtn.disabled) sendMessage();\n  }\n};\n\n// بارگذاری اولیه\n(async () => {\n  const savedKey = localStorage.getItem('sh3n_api_key');\n  if (savedKey) {\n    try {\n      const models = await fetchModels(savedKey);\n      localStorage.setItem('sh3n_api_key', savedKey);\n      buildModelList(models);\n      document.getElementById('login-overlay').classList.add('hidden');\n    } catch {\n      document.getElementById('login-overlay').classList.remove('hidden');\n    }\n  } else {\n    document.getElementById('login-overlay').classList.remove('hidden');\n  }\n})();\n\n</script>\n</body>\n</html>"
